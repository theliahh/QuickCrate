-- Waylaid Crates and the bundles each one takes, keyed by item ID.
-- Bundles are in the game's own order (from each crate's Stock Crate spell).

export type Bundle = { item: number, count: number }
export type Crate = { name: string, bundles: Bundle[] }

--- The Forged Delivery Receipt: turns an unfilled crate into a Notarized Shipping Container.

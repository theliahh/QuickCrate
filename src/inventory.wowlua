-- Reads the bags and works out, for each Waylaid Crate, which bundle the next
-- fill will use or what is still missing. Pure logic: no frames.
import CRATES, RECEIPT_ID, FALLBACK_NAMES from "/data"
import type Bundle from "/data"

export type Slot = { bag: number, slot: number }
export type Stack = { bag: number, slot: number, count: number }
export type Shortfall = { item: number, count: number, missing: number }

export type CrateRow = {
    id: number,
    name: string,
    count: number,
    slots: Slot[],
    -- the bundle the next fill uses, nil when the bags cover none
    bundle: Bundle?,
    -- the stack of the bundle's material that Fill points the game at
    stack: Stack?,
    -- the bags hold enough of the material, but no single stack does
    needsStacking: boolean,
    -- when no bundle is covered: the one closest to complete
    closest: Shortfall?,
}

export type ManualRow = { id: number, name: string, count: number }

export type Model = {
    crates: CrateRow[],
    manual: ManualRow[],
    receipts: number,
    receiptSlots: Slot[],
}

--- The last bag scanned: the backpack is 0, then the equipped bags and the
--- reagent bag (5). Bank tabs come after these and are never scanned.
export const LAST_BAG = NUM_TOTAL_EQUIPPED_BAG_SLOTS ?? 5

--- The item's name from the client, or the English fallback while it loads.
export function itemName(id: number): string
    local name = C_Item.GetItemNameByID(id)
    if name ~= nil and name ~= "" then
        return name
    end
    return FALLBACK_NAMES[id] ?? CRATES[id]?.name ?? `item {id}`
end

local sortedCrateIDs: number[] = {}
for id in pairs(CRATES) do
    sortedCrateIDs[#sortedCrateIDs + 1] = id
end
table.sort(sortedCrateIDs)

--- The first bundle, in game order, the counts fully cover.
local function coveredBundle(bundles: Bundle[], counts: { [number]: number }): Bundle?
    for _, b in ipairs(bundles) do
        if (counts[b.item] ?? 0) >= b.count then
            return b
        end
    end
    return nil
end

--- How many of the item one bag slot holds; 0 until the client knows.
export function maxStackOf(item: number): number
    local info: any = { C_Item.GetItemInfo(item) }
    local maxStack = info[8]
    if type(maxStack) == "number" and maxStack > 0 then
        return maxStack
    end
    return 0
end

--- How much one stack must hold for the game to take `count` of the item
--- from it: the full amount, or a full stack when the amount is more than
--- one stack holds. Until the client knows the stack size, the full amount.
export function stackNeed(item: number, count: number): number
    local maxStack = maxStackOf(item)
    if maxStack > 0 and maxStack < count then
        return maxStack
    end
    return count
end

--- The smallest stack holding at least `need`; ties go to bag order.
local function smallestEnough(stacks: Stack[], need: number): Stack?
    local best: Stack? = nil
    for _, s in ipairs(stacks) do
        if s.count >= need and (best == nil or s.count < best.count) then
            best = s
        end
    end
    return best
end

--- Every stack of the item in the bags, in bag order.
export function stacksOf(item: number): Stack[]
    local stacks: Stack[] = {}
    for bag = 0, LAST_BAG do
        for slot = 1, C_Container.GetContainerNumSlots(bag) do
            local info = C_Container.GetContainerItemInfo(bag, slot)
            if info ~= nil and info.itemID == item then
                stacks[#stacks + 1] = { bag = bag, slot = slot, count = info.stackCount ?? 1 }
            end
        end
    end
    return stacks
end

--- The stack Fill should point at for `count` of the item, from the bags as
--- they are now; nil when no stack is big enough.
export function chooseStack(item: number, count: number): Stack?
    return smallestEnough(stacksOf(item), stackNeed(item, count))
end

--- The bundle with the fewest items missing; ties go to game order.
local function closestBundle(bundles: Bundle[], counts: { [number]: number }): Shortfall?
    local best: Shortfall? = nil
    for _, b in ipairs(bundles) do
        local missing = b.count - (counts[b.item] ?? 0)
        if best == nil or missing < best.missing then
            best = { item = b.item, count = b.count, missing = missing }
        end
    end
    return best
end

export function scan(): Model
    local counts: { [number]: number } = {}
    local stacksByID: { [number]: Stack[] } = {}
    local receiptSlots: Slot[] = {}

    for bag = 0, LAST_BAG do
        for slot = 1, C_Container.GetContainerNumSlots(bag) do
            local info = C_Container.GetContainerItemInfo(bag, slot)
            if info ~= nil and info.itemID ~= nil then
                local id = info.itemID
                local count = info.stackCount ?? 1
                counts[id] = (counts[id] ?? 0) + count
                local stacks = stacksByID[id]
                if stacks == nil then
                    stacks = {}
                    stacksByID[id] = stacks
                end
                stacks[#stacks + 1] = { bag = bag, slot = slot, count = count }
                if id == RECEIPT_ID then
                    receiptSlots[#receiptSlots + 1] = { bag = bag, slot = slot }
                end
            end
        end
    end

    local crates: CrateRow[] = {}
    for _, id in ipairs(sortedCrateIDs) do
        local slots = stacksByID[id]
        if slots ~= nil then
            local bundles = CRATES[id].bundles
            local bundle = coveredBundle(bundles, counts)
            local stack: Stack? = nil
            if bundle ~= nil then
                stack = smallestEnough(stacksByID[bundle.item] ?? {}, stackNeed(bundle.item, bundle.count))
            end
            crates[#crates + 1] = {
                id = id,
                name = itemName(id),
                count = counts[id],
                slots = slots,
                bundle = bundle,
                stack = stack,
                needsStacking = bundle ~= nil and stack == nil,
                closest = bundle == nil and closestBundle(bundles, counts) or nil,
            }
        end
    end

    local manual: ManualRow[] = {}
    for id, _ in pairs(stacksByID) do
        if CRATES[id] == nil and id ~= RECEIPT_ID then
            local name = itemName(id)
            if name:sub(1, 7) == "Waylaid" then
                manual[#manual + 1] = { id = id, name = name, count = counts[id] }
            end
        end
    end
    table.sort(manual, function(a: ManualRow, b: ManualRow): boolean return a.id < b.id end)

    return {
        crates = crates,
        manual = manual,
        receipts = counts[RECEIPT_ID] ?? 0,
        receiptSlots = receiptSlots,
    }
end

--- Whether the item is one QuickCrate acts on: a known crate or a receipt.
export function isTracked(id: number?): boolean
    return id ~= nil and (CRATES[id] ~= nil or id == RECEIPT_ID)
end

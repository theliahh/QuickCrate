-- The QuickCrate window: one row per kind of Waylaid Crate in the bags, each
-- with a line saying what the next fill uses and secure Fill / Receipt buttons.
import onLoad from "wowlua:lifecycle"
import print from "wowlua:log"
import defer, onCombatChange from "wowlua:combat"
import RECEIPT_ID from "/data"
import scan, itemName, chooseStack from "/inventory"
import startStacking, isStacking from "/stacker"
import type CrateRow, ManualRow, Model, Stack from "/inventory"
import SKINS, activeSkin, saveSkin from "/skins"
import type Skin, Color from "/skins"
import db from "/db"

const ROW_HEIGHT = 40
const HEADER_LINE = 18
const BUTTON_WIDTH = 64
-- above any skin's border art, so text and buttons are never covered
const OVERLAY_LEVEL = 700

const DIM = "|cffa0a0a0"
const NAME_PREFIX = "^Waylaid Crate: "

export const frame = CreateFrame("Frame", "QuickCrateFrame", UIParent)
frame:SetSize(380, 120)
frame:SetPoint("CENTER")
frame:SetFrameStrata("DIALOG")
frame:SetClampedToScreen(true)
frame:SetMovable(true)
frame:EnableMouse(true)
frame:RegisterForDrag("LeftButton")
frame:Hide()

--- Holds the title, texts and title-bar buttons above the skin's art.
export const overlay = CreateFrame("Frame", nil, frame)
overlay:SetAllPoints()
overlay:SetFrameLevel(OVERLAY_LEVEL)

local title = overlay:CreateFontString(nil, "OVERLAY", "GameFontNormal")
title:SetText("QuickCrate")

export const closeButton = CreateFrame("Button", nil, overlay, "UIPanelCloseButton")

--- The receipt count, or why no receipt can be applied.
export const receiptHeader = overlay:CreateFontString(nil, "OVERLAY", "GameFontHighlightSmall")
receiptHeader:SetJustifyH("LEFT")

--- Shown when there is nothing to fill.
export const emptyText = overlay:CreateFontString(nil, "OVERLAY", "GameFontHighlightSmall")
emptyText:SetText("No Waylaid Crates in your bags.")

export type Row = {
    frame: Frame,
    icon: Texture,
    name: FontString,
    line: FontString,
    fill: Button,
    receipt: Button,
    stripe: Texture,
    divider: Texture,
}

-- The skin the window is drawn in, and each skin's art once built.
local applied: Skin = SKINS[1]
local chromes: { [string]: any[] } = {}

--- The id of the skin the window is currently drawn in.
export function appliedSkin(): string
    return applied.id
end

--- Puts a skin's art on a window, building it on first use, and hides the art of every other skin.
export function showChrome(host: Frame, layer: Frame, store: { [string]: any[] }, skin: Skin)
    for id, objects in pairs(store) do
        for _, o in ipairs(objects) do
            o:SetShown(id == skin.id)
        end
    end
    if store[skin.id] == nil then
        store[skin.id] = skin.build(host, layer)
    end
end

--- Styles a font string as the skin's title.
export function styleTitle(text: FontString, skin: Skin)
    text:SetFontObject(skin.titleFont)
    local c = skin.titleColor
    if c ~= nil then
        text:SetTextColor(c.r, c.g, c.b, c.a)
        text:SetShadowOffset(0, 0)
    else
        text:SetTextColor(1, 0.82, 0, 1)
        text:SetShadowOffset(1, -1)
    end
    text:ClearAllPoints()
    if skin.titleCentered then
        text:SetPoint("TOP", 0, skin.titleY)
    else
        text:SetPoint("TOPLEFT", skin.side, skin.titleY)
    end
end

--- Colours a body text in the skin's ink, or the font's own white when it has none.
export function ink(text: FontString, skin: Skin)
    local c: Color? = skin.ink
    if c ~= nil then
        text:SetTextColor(c.r, c.g, c.b, c.a)
        text:SetShadowOffset(0, 0)
    else
        text:SetTextColor(1, 1, 1, 1)
        text:SetShadowOffset(1, -1)
    end
end

local function applyChrome(skin: Skin)
    applied = skin
    showChrome(frame, overlay, chromes, skin)
    frame:SetWidth(skin.width)
    closeButton:ClearAllPoints()
    closeButton:SetPoint("TOPRIGHT", skin.closeX, skin.closeY)
    styleTitle(title, skin)
    ink(receiptHeader, skin)
    ink(emptyText, skin)
end

export const rows: Row[] = {}

local function savePosition()
    local point, _, _, x, y = frame:GetPoint(1)
    if point ~= nil and not issecretvalue(x) and not issecretvalue(y) then
        db.position = { point = point, x = x, y = y }
    end
end

frame:SetScript("OnDragStart", function(self: Frame) self:StartMoving() end)
frame:SetScript("OnDragStop", function(self: Frame)
    self:StopMovingOrSizing()
    savePosition()
end)

@onLoad
local function restorePosition()
    local p = db.position
    if p ~= nil then
        frame:ClearAllPoints()
        local point: any = p.point
        frame:SetPoint(point, UIParent, point, p.x, p.y)
    end
end

--- Points a receipt button at a crate of its row's kind that is in the bags now.
local function retargetReceipt(button: Button)
    if InCombatLockdown() then
        return
    end
    local crateID = button:GetAttribute("quickcrate-crate")
    for _, row in ipairs(scan().crates) do
        if row.id == crateID then
            local s = row.slots[1]
            button:SetAttribute("target-bag", s.bag)
            button:SetAttribute("target-slot", s.slot)
            return
        end
    end
end

--- Points a Fill button at one stack of the material. Without a stack, the
--- secure button falls back to targeting the material by name, and the game
--- picks the stack.
local function pointAt(button: Button, stack: Stack?)
    button:SetAttribute("target-bag", stack?.bag)
    button:SetAttribute("target-slot", stack?.slot)
end

--- The material and amount of the bundle a Fill button's row uses, or nil
--- when the bags cover no bundle.
local function bundleOf(button: Button): (number?, number?)
    local item = button:GetAttribute("quickcrate-material")
    local amount = button:GetAttribute("quickcrate-amount")
    if type(item) == "number" and type(amount) == "number" then
        return item, amount
    end
    return nil, nil
end

--- Re-picks a Fill button's stack from the bags as they are now, in case the
--- material moved or was used since the window drew.
local function retargetFill(button: Button)
    if InCombatLockdown() then
        return
    end
    local item, amount = bundleOf(button)
    if item ~= nil and amount ~= nil then
        pointAt(button, chooseStack(item, amount))
    end
end

-- Fill is one click when the crate asks for its target at once: the secure
-- button uses the crate, then targets the bundle's material. It points at a
-- stack big enough for the bundle, because the game refuses a fill from a
-- smaller stack even when the bags hold more elsewhere.
-- When the crate only asks after a cast, the button is armed for a second
-- click that targets the material alone.
local pendingFill: Button? = nil
local pendingAt = 0
local armedFill: Button? = nil

const ARM_WINDOW = 3

local function rememberFillClick(button: Button)
    pendingFill = button
    pendingAt = GetTime()
end

-- set to render once it is defined below
local redraw: () -> () = function() end

-- When the bags hold enough of the material but no stack is big enough, the
-- button reads Stack instead: it uses no item, and its click merges the
-- material's stacks so the next click can Fill.
local function onFillClick(button: Button)
    if button:GetAttribute("quickcrate-stack") ~= true then
        rememberFillClick(button)
        return
    end
    local item, amount = bundleOf(button)
    if item ~= nil and amount ~= nil and startStacking(item, amount, function() redraw() end) then
        button:Disable()
    end
end

local function arm(button: Button)
    armedFill = button
    pendingFill = nil
    button:SetAttribute("item", nil)
    button:SetText("Put in")
end

local function disarm()
    local button = armedFill
    armedFill = nil
    if button ~= nil then
        button:SetAttribute("item", button:GetAttribute("quickcrate-item"))
        button:SetText("Fill")
    end
end

--- Watches for the crate's item target while a fill is in progress.
local function watchFill()
    if InCombatLockdown() then
        return
    end
    if armedFill ~= nil then
        if not SpellCanTargetItem() then
            disarm()
        end
    elseif pendingFill ~= nil then
        if SpellCanTargetItem() then
            arm(pendingFill)
        elseif GetTime() - pendingAt > ARM_WINDOW then
            pendingFill = nil
        end
    end
end

frame:SetScript("OnUpdate", watchFill)

local function secureButton(parent: Frame, label: string): Button
    local b = CreateFrame("Button", nil, parent, "SecureActionButtonTemplate, UIPanelButtonTemplate")
    b:SetSize(BUTTON_WIDTH, 20)
    b:SetText(label)
    b:RegisterForClicks("LeftButtonUp", "LeftButtonDown")
    b:SetAttribute("type", "item")
    return b
end

local function getRow(i: number): Row
    local row = rows[i]
    if row ~= nil then
        return row
    end
    local f = CreateFrame("Frame", nil, frame)
    f:SetHeight(ROW_HEIGHT)
    f:SetFrameLevel(OVERLAY_LEVEL - 10)
    local stripe = f:CreateTexture(nil, "BACKGROUND")
    stripe:SetPoint("TOPLEFT", -4, 1)
    stripe:SetPoint("BOTTOMRIGHT", 4, -1)
    local divider = f:CreateTexture(nil, "ARTWORK")
    divider:SetHeight(1)
    divider:SetPoint("TOPLEFT", 0, 1)
    divider:SetPoint("TOPRIGHT", 0, 1)
    local icon = f:CreateTexture(nil, "ARTWORK")
    icon:SetSize(28, 28)
    icon:SetPoint("LEFT", 0, 0)
    local name = f:CreateFontString(nil, "OVERLAY", "GameFontHighlight")
    name:SetPoint("TOPLEFT", icon, "TOPRIGHT", 6, 0)
    name:SetPoint("RIGHT", f, "RIGHT", -(2 * BUTTON_WIDTH + 8), 0)
    name:SetJustifyH("LEFT")
    name:SetWordWrap(false)
    local line = f:CreateFontString(nil, "OVERLAY", "GameFontHighlightSmall")
    line:SetPoint("BOTTOMLEFT", icon, "BOTTOMRIGHT", 6, 0)
    line:SetPoint("RIGHT", f, "RIGHT", -(2 * BUTTON_WIDTH + 8), 0)
    line:SetJustifyH("LEFT")
    line:SetWordWrap(false)
    local fill = secureButton(f, "Fill")
    fill:SetPoint("RIGHT", f, "RIGHT", 0, 0)
    fill:SetScript("PreClick", retargetFill)
    fill:SetScript("PostClick", onFillClick)
    local receipt = secureButton(f, "Receipt")
    receipt:SetPoint("RIGHT", fill, "LEFT", -4, 0)
    receipt:SetAttribute("item", `item:{RECEIPT_ID}`)
    receipt:SetScript("PreClick", retargetReceipt)
    row = {
        frame = f, icon = icon, name = name, line = line, fill = fill, receipt = receipt,
        stripe = stripe, divider = divider,
    }
    rows[i] = row
    return row
end

--- The text under a crate's name: what the next fill uses, or what is missing.
export function fillLine(crate: CrateRow, skin: Skin): string
    local b = crate.bundle
    if b ~= nil then
        return `{skin.good}Fills with {b.count}× {itemName(b.item)}|r`
    end
    local c = crate.closest
    if c ~= nil then
        return `{skin.bad}Need {c.missing} more {itemName(c.item)}|r`
    end
    return ""
end

local function nameWithCount(name: string, count: number): string
    return count > 1 and `{name} ×{count}` or name
end

--- Places a row inside the skin's room and gives it the skin's decoration.
local function dressRow(row: Row, index: number, top: number, skin: Skin)
    row.frame:ClearAllPoints()
    row.frame:SetPoint("TOPLEFT", skin.side, -(top + (index - 1) * ROW_HEIGHT))
    row.frame:SetWidth(skin.width - 2 * skin.side)
    local s = skin.rowStripe
    row.stripe:SetShown(s ~= nil and index % 2 == 1)
    if s ~= nil then
        row.stripe:SetColorTexture(s.r, s.g, s.b, s.a)
    end
    local d = skin.rowDivider
    row.divider:SetShown(d ~= nil and index > 1)
    if d ~= nil then
        row.divider:SetColorTexture(d.r, d.g, d.b, d.a)
    end
    ink(row.name, skin)
    -- the line's colour comes from its text; ink skins only drop its shadow
    if skin.ink ~= nil then
        row.line:SetShadowOffset(0, 0)
    else
        row.line:SetShadowOffset(1, -1)
    end
    row.frame:Show()
end

local function showCrate(row: Row, crate: CrateRow, receipts: number)
    row.icon:SetTexture(C_Item.GetItemIconByID(crate.id))
    row.name:SetText(nameWithCount((crate.name:gsub(NAME_PREFIX, "")), crate.count))
    row.line:SetText(fillLine(crate, applied))
    local crateItem = `item:{crate.id}`
    local b = crate.bundle
    row.fill:SetAttribute("quickcrate-item", crateItem)
    row.fill:SetAttribute("target-item", b ~= nil and itemName(b.item) or nil)
    row.fill:SetAttribute("quickcrate-material", b?.item)
    row.fill:SetAttribute("quickcrate-amount", b?.count)
    pointAt(row.fill, crate.stack)
    row.fill:SetAttribute("quickcrate-stack", crate.needsStacking)
    if row.fill == armedFill then
        row.fill:SetAttribute("item", nil)
    elseif crate.needsStacking then
        row.fill:SetAttribute("item", nil)
        row.fill:SetText("Stack")
    else
        row.fill:SetAttribute("item", crateItem)
        row.fill:SetText("Fill")
    end
    row.fill:SetEnabled(b ~= nil and not isStacking())
    row.fill:Show()
    local s = crate.slots[1]
    row.receipt:SetAttribute("quickcrate-crate", crate.id)
    row.receipt:SetAttribute("target-bag", s.bag)
    row.receipt:SetAttribute("target-slot", s.slot)
    row.receipt:SetShown(receipts > 0)
end

local function showManual(row: Row, item: ManualRow)
    row.icon:SetTexture(C_Item.GetItemIconByID(item.id))
    row.name:SetText(nameWithCount(item.name, item.count))
    row.line:SetText(`{DIM}Fill by hand|r`)
    row.fill:Hide()
    row.receipt:Hide()
end

local function receiptText(model: Model): string?
    if model.receipts == 0 then
        return nil
    end
    if #model.crates == 0 then
        return "No unfilled crates"
    end
    return `Forged Delivery Receipts: {model.receipts}`
end

--- Rebuilds the rows from the bags. Changes secure buttons, so out of combat only.
export function render()
    if InCombatLockdown() then
        return
    end
    local skin = applied
    local model = scan()
    local top = skin.top

    local header = receiptText(model)
    receiptHeader:SetShown(header ~= nil)
    if header ~= nil then
        receiptHeader:SetText(header)
        receiptHeader:ClearAllPoints()
        receiptHeader:SetPoint("TOPLEFT", skin.side, -top)
        top += HEADER_LINE
    end

    local used = 0
    for _, crate in ipairs(model.crates) do
        used += 1
        local row = getRow(used)
        dressRow(row, used, top, skin)
        showCrate(row, crate, model.receipts)
    end
    for _, item in ipairs(model.manual) do
        used += 1
        local row = getRow(used)
        dressRow(row, used, top, skin)
        showManual(row, item)
    end
    for i = used + 1, #rows do
        rows[i].frame:Hide()
    end

    emptyText:SetShown(used == 0)
    if used == 0 then
        emptyText:ClearAllPoints()
        emptyText:SetPoint("TOPLEFT", skin.side, -top)
        used = 1
    end
    frame:SetHeight(math.max(top + used * ROW_HEIGHT + skin.bottom, skin.minHeight))
end
redraw = render

--- Draws the window in the player's skin. Resizing a window with secure
--- buttons is blocked in combat, so in combat this waits for combat to end;
--- of several calls in one fight, only the last applies.
export function restyle()
    defer(function()
        applyChrome(activeSkin())
        if frame:IsShown() then
            render()
        end
    end, "quickcrate-restyle")
end

--- Saves a skin as the player's choice and redraws the window in it.
export function setSkin(id: string)
    saveSkin(id)
    restyle()
end

@onLoad
local function firstStyle()
    restyle()
end

local pendingOpen = false

--- Opens the window, or after combat when the player is in combat.
export function open()
    if InCombatLockdown() then
        if not pendingOpen then
            print("QuickCrate will open after combat.")
        end
        pendingOpen = true
        return
    end
    pendingOpen = false
    render()
    frame:Show()
end

export function close()
    if InCombatLockdown() then
        print("QuickCrate can't close during combat.")
        return
    end
    frame:Hide()
end

export function toggle()
    if frame:IsShown() then
        close()
    else
        open()
    end
end

--- Runs the open that combat held back.
export function afterCombat()
    if pendingOpen then
        open()
    end
end

closeButton:SetScript("OnClick", close)

-- Esc closes the window, as Blizzard's own panels do. Hiding a window with
-- secure buttons is blocked in combat, so it leaves Esc's list while fighting.
const FRAME_NAME = "QuickCrateFrame"

local function setEscCloses(on: boolean)
    for i = #UISpecialFrames, 1, -1 do
        if UISpecialFrames[i] == FRAME_NAME then
            table.remove(UISpecialFrames, i)
        end
    end
    if on then
        table.insert(UISpecialFrames, FRAME_NAME)
    end
end

setEscCloses(not InCombatLockdown())
onCombatChange(function(entering: boolean)
    setEscCloses(not entering)
end)
